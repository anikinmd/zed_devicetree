{
  "DeviceTree: Linux kernel configuration": {
    "prefix": "devicetree-linux",
    "description": "dts-language-server settings for a Linux kernel tree",
    "body": [
      "\"lsp\": {",
      "  \"dts-language-server\": {",
      "    \"settings\": {",
      "      \"devicetree\": {",
      "        \"contexts\": [",
      "          {",
      "            \"ctxName\": \"${1:my-board}\",",
      "            \"dtsFile\": \"arch/${2:arm64}/boot/dts/${3:vendor/my-board}.dts\",",
      "            \"includePaths\": [",
      "              \"include\",",
      "              \"arch/${2:arm64}/boot/dts/${4:vendor}\",",
      "              \"arch/${2:arm64}/boot/dts\"",
      "            ]",
      "          }",
      "        ],",
      "",
      "        // Property validation against devicetree.org schemas. Needs a",
      "        // checkout of https://github.com/devicetree-org/dt-schema",
      "        \"defaultDeviceOrgBindingsMetaSchema\": [",
      "          // \"/path/to/dt-schema/dtschema/meta-schemas\"",
      "        ],",
      "        \"defaultDeviceOrgTreeBindings\": [",
      "          // \"/path/to/dt-schema/dtschema/schemas\",",
      "          // \"Documentation/devicetree/bindings\"",
      "        ]",
      "      }",
      "    }",
      "  }",
      "},$0"
    ]
  },

  "DeviceTree: Zephyr configuration": {
    "prefix": "devicetree-zephyr",
    "description": "dts-language-server settings for a Zephyr west workspace",
    "body": [
      "\"lsp\": {",
      "  \"dts-language-server\": {",
      "    \"settings\": {",
      "      \"devicetree\": {",
      "        // Only needed when the automatic lookup picks the wrong tree.",
      "        // \"zephyrBase\": \"/opt/nordic/ncs/v3.0.0/zephyr\",",
      "",
      "        \"defaultBindingType\": \"Zephyr\",",
      "        \"defaultZephyrBindings\": [",
      "          \"\\${zephyrBase}/dts/bindings\",",
      "          \"dts/bindings\"",
      "        ],",
      "        \"defaultIncludePaths\": [",
      "          \"\\${zephyrBase}/dts\",",
      "          \"\\${zephyrBase}/dts/common\",",
      "          \"\\${zephyrBase}/dts/vendor\",",
      "          \"\\${zephyrBase}/dts/arm\",",
      "          \"\\${zephyrBase}/dts/arm64\",",
      "          \"\\${zephyrBase}/dts/riscv\",",
      "          \"\\${zephyrBase}/dts/xtensa\",",
      "          \"\\${zephyrBase}/include\",",
      "          \"dts\",",
      "          \"include\"",
      "        ],",
      "        \"contexts\": [",
      "          {",
      "            \"ctxName\": \"${1:nrf52840dk}\",",
      "            \"dtsFile\": \"\\${zephyrBase}/boards/${2:nordic/nrf52840dk/nrf52840dk_nrf52840}.dts\",",
      "            \"overlays\": [\"boards/${3:nrf52840dk_nrf52840}.overlay\"]",
      "          }",
      "        ],",
      "        \"preferredContext\": 0,",
      "        \"defaultShowFormattingErrorAsDiagnostics\": true,",
      "        \"defaultLockRenameEdits\": [\"\\${zephyrBase}\"]",
      "      }",
      "    }",
      "  }",
      "},$0"
    ]
  }
}
